{
  "name": "nas-ui",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -F @nas-ui/ui build",
    "typecheck": "pnpm -r --parallel typecheck",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.6.3",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "pkg-pr-new": "^0.0.91",
    "typescript-eslint": "^8.72.0"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "!(*.{js,ts,vue})": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  }
}
