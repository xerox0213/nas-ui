{
  "name": "nas-ui",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -F @nas-ui/ui build",
    "typecheck": "pnpm -r --parallel typecheck",
    "fmt": "prettier . --write",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "^10.11.0",
    "eslint-plugin-storybook": "^10.6.1",
    "globals": "^17.12.0",
    "prettier": "3.9.8",
    "typescript-eslint": "^8.70.1"
  }
}
