  },
  "devDependencies": {
    "@lucide/vue": "^1.50.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/vue3-vite": "^10.6.1",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/tsconfig": "catalog:",
    "storybook": "^10.6.1",
    "tailwindcss": "catalog:",
    "tsdown": "^0.23.1",
    "typescript": "catalog:",
    "unplugin-vue": "^8.0.0",
    "vite": "catalog:",
    "vue": "catalog:",
    "vue-router": "^5.3.0",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "@lucide/vue": "^1.50.0",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.0"
  }
}
